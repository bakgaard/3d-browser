# Raspberry Pi 5 deployment env. Copy to ".env" on the Pi next to docker-compose.pi.yml.

# --- Pull pre-built multi-arch images from GHCR ---
REGISTRY=ghcr.io
IMAGE_OWNER=bakgaard
# Pin to a released version tag once cut (e.g. 0.1.0); "latest" also works.
IMAGE_TAG=latest

# --- Database ---
# Must match the password of the dump you restore. Change it from the default.
POSTGRES_PASSWORD=change-me

# --- Web UI port on the Pi (Traefik proxies to http://192.168.2.118:${FRONTEND_PORT}) ---
FRONTEND_PORT=8081

# --- Cosmetic only on the Pi: the "Copy path" button echoes this Windows root ---
HOST_ROOT=E:\Patreon
