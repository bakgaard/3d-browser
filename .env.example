# Copy this file to ".env" and adjust the paths for your machine.

# --- Where your library lives (read by the containers) ---
# Use FORWARD slashes for the mount sources on Windows (Docker Desktop accepts them).
PATREON_PATH=E:/Patreon

# Target of the "Epic Miniatures.lnk" shortcut (a different drive). Mounted read-only so it
# scans like a normal artist. If you don't have this, point it at any existing folder.
EPIC_PATH=D:/3D/Inactive Patreon/Epic Miniatures

# --- Windows host path of the primary library (used to open Explorer) ---
# Use BACKSLASHES here; this is what gets handed to the Explorer helper.
HOST_ROOT=E:\Patreon

# --- Web UI port on your machine ---
FRONTEND_PORT=8081

# --- Production (docker-compose.prod.yml) only: pull pre-built images from GHCR ---
# IMAGE_OWNER is your GitHub username/org that owns the packages.
REGISTRY=ghcr.io
IMAGE_OWNER=your-github-username
IMAGE_TAG=latest
# Override the default local Postgres password in production.
POSTGRES_PASSWORD=patreon
